# Copy to .env and fill in real values. Never commit .env.
#
# Names follow the AWS SDK conventions and the archiver that writes the keys,
# so a single file can configure both applications.

# --- S3-compatible object storage ------------------------------------------
# Garage / MinIO / Ceph / AWS all work. Credentials are NOT listed here: the
# default boto3 chain resolves them from AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (plus AWS_SESSION_TOKEN), AWS_PROFILE,
# ~/.aws/credentials, or an instance role.
AWS_ENDPOINT_URL_S3=http://s3.example.internal/

# Region used to sign every request and every presigned URL. Required: a
# presigned URL cannot be re-signed once a browser holds it, and S3-compatible
# gateways do not report the correct region when a signature is rejected.
AWS_REGION=us-east-1

# --- Archive layout ---------------------------------------------------------
S3_BUCKET=example-bucket
# Top-level folder holding <camera>/<year>/<month>/<day>/<hour>/<MM>-<SS>.mp4
# Leave it empty (or unset) when the cameras sit directly at the bucket root.
S3_PREFIX=archive

# IANA zone the archiver used when it named the year/month/day/hour folders.
# Display only: the viewer shows it in the page footer and never converts any
# time with it. When unset, the line is not rendered at all.
# S3_KEY_TIMEZONE=Europe/Berlin

# --- Host -> direct access mapping ------------------------------------------
# JSON object keyed by the incoming HTTP Host header. Hosts listed here get
# presigned browser->S3 URLs; every other Host is streamed through the proxy.
# Value is either an endpoint URL string (path style) or an object that also
# selects the addressing style, which is configurable per mapped host only.
# ARCHIVE_HOST_MAP={"archive.example.com": {"endpoint_url": "https://s3-public.example.com", "addressing_style": "virtual"}}
ARCHIVE_HOST_MAP={}

# --- Optional tuning --------------------------------------------------------
# ARCHIVE_PRESIGN_EXPIRY=3600
# ARCHIVE_MAX_YEAR_SPAN=5
# ARCHIVE_PROXY_CHUNK_SIZE=262144
# ARCHIVE_PROXY_CACHE_CONTROL=private, max-age=300
